});

async function buscarTaxaBRL(){
    try{
        const res = await fetch(`${API_CG}/simple/price?ids=usd&vs_currencies=brl`, {cache:'force-cache'});
        const dados = await res.json();
        taxaBRL = dados.usd.brl || 5.40;
    }catch(e){taxaBRL=5.40;}
}

async function atualizarDados(){
    await buscarTaxaBRL();
    try{
        const cacheKey = 'dados-gerais';
        if(cacheDados[cacheKey] && Date.now() - cacheDados[cacheKey].tempo < 120000){
            processarDadosGerais(cacheDados[cacheKey].dados);
            return;
        }
        const resCG = await fetch(`${API_CG}/simple/price?ids=doge-manga,bitcoin,ethereum,solana&vs_currencies=usd&include_24hr_change=true`, {cache:'no-store'});
        if(!resCG.ok) throw new Error('API indisponível');
        const dadosCG = await resCG.json();
        cacheDados[cacheKey] = {dados:dadosCG, tempo:Date.now()};
        processarDadosGerais(dadosCG);
    }catch(e){
        console.warn('Erro dados gerais:', e);
        document.getElementById('barraPrecos').innerHTML = `<div class="item-moeda destaque"><span>Dados temporariamente indisponíveis</span></div>`;
    }
    try{
        const resDS = await fetch(`https://api.dexscreener.com/latest/dex/tokens/${CONTRATO}`, {cache:'no-store'});
        const dadosDS = await resDS.json();
        const par = dadosDS?.pairs?.[0];
        document.getElementById('liquidez').innerText = par?.liquidity?.usd ? `$${parseFloat(par.liquidity.usd).toLocaleString('pt-BR')}` : 'Aguardando';
        document.getElementById('fdv').innerText = par?.fdv ? `$${parseFloat(par.fdv).toLocaleString('pt-BR')}` : 'Aguardando';
        document.getElementById('marketCap').innerText = par?.marketCap ? `$${parseFloat(par.marketCap).toLocaleString('pt-BR')}` : 'Aguardando';
    }catch(e){}
}

function processarDadosGerais(dadosCG){
    if(dadosCG['doge-manga']){
        document.getElementById('precoDGM').innerText = `$${parseFloat(dadosCG['doge-manga'].usd).toFixed(6)}`;
        document.getElementById('volume24').innerText = `$${parseFloat(dadosCG['doge-manga'].usd_24h_volume || 0).toLocaleString('pt-BR')}`;
    }
    document.getElementById('barraPrecos').innerHTML = `
        <div class="item-moeda destaque"><img src="IMG-20260727-WA0036(7).jpg" style="width:18px; border-radius:50%;"><strong>$DGM</strong>: ${dadosCG['doge-manga'] ? `$${parseFloat(dadosCG['doge-manga'].usd).toFixed(6)}` : 'Aguardando listagem'}</div>
        <div class="item-moeda">BTC: $${parseFloat(dadosCG.bitcoin?.usd||0).toLocaleString('pt-BR')}</div>
        <div class="item-moeda">ETH: $${parseFloat(dadosCG.ethereum?.usd||0).toLocaleString('pt-BR')}</div>
        <div class="item-moeda">SOL: $${parseFloat(dadosCG.solana?.usd||0).toLocaleString('pt-BR')}</div>`;
}

async function buscarMoedasGlobal(){
    termoPesquisaGlobal = document.getElementById('pesquisaGlobal').value.trim();
    if(!termoPesquisaGlobal){carregarRankingGlobal();return;}
    document.getElementById('areaResultadosGlobal').innerHTML = `<div class="carregando">🔍 Buscando moedas...</div>`;
    try{
        const res = await fetch(`${API_CG}/search?query=${encodeURIComponent(termoPesquisaGlobal)}`, {cache:'no-store'});
        if(res.status===429){
            document.getElementById('areaResultadosGlobal').innerHTML = `<div class="aviso-api">⏳ Muitas requisições — aguarde 1 minuto e tente novamente</div>`;
            setTimeout(buscarMoedasGlobal, 65000);
            return;
        }
        const dados = await res.json();
        if(!dados.coins || dados.coins.length===0){
            document.getElementById('areaResultadosGlobal').innerHTML = `<div class="erro-busca">❌ Nenhuma moeda encontrada para "${termoPesquisaGlobal}"</div>`;
            return;
        }
        exibirListaMoedas(dados.coins.slice(0,50));
    }catch(e){
        document.getElementById('areaResultadosGlobal').innerHTML = `<div class="erro-busca">❌ Erro na busca: ${e.message}</div>`;
    }
}

