    const atual = idiomas.indexOf(document.getElementById('btnIdioma').innerText);
    document.getElementById('btnIdioma').innerText = idiomas[(atual+1)%3];
};

document.querySelectorAll('.aba, .menu-item, #btnVoltarMenu').forEach(item=>{
    if(item.id === 'btnTema' || item.id === 'btnIdioma') return;
    item.addEventListener('click', (e)=>{
        e.preventDefault();
        document.querySelectorAll('.aba, .menu-item').forEach(i=>i.classList.remove('ativo'));
        document.querySelectorAll('.secao').forEach(s=>s.classList.remove('ativa'));
        if(item.dataset.secao){
            document.querySelector(`[data-secao="${item.dataset.secao}"]`).classList.add('ativo');
