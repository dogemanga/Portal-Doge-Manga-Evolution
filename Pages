<script>
const CONTRATO = "E9qgVy6urPUrKBv3wymPSgSPbDGM5z77ZnVok4YvUmqE";
const API_CG = "https://api.coingecko.com/api/v3";
let temaEscuro = true;
let paginaGlobal = 1;
let cacheDados = {};
let taxaBRL = 5.40;

document.addEventListener('DOMContentLoaded', () => {
    setTimeout(() => document.getElementById('splash').classList.add('oculto'), 1800);
    inicializarEventos();
    atualizarDados();
    setInterval(atualizarDados, 180000);
});

function inicializarEventos(){
    document.getElementById('btnCopiarContrato')?.addEventListener('click', () => {
        navigator.clipboard.writeText(CONTRATO);
        const aviso = document.getElementById('avisoCopiado');
        if(aviso){ aviso.style.display = 'block'; setTimeout(()=>aviso.style.display='none',2500); }
    });

    document.getElementById('btnMenu')?.addEventListener('click', (e) => {
        e.stopPropagation();
        document.getElementById('menuNavegacao').classList.toggle('mostrar');
    });
    document.addEventListener('click', () => {
        document.getElementById('menuNavegacao').classList.remove('mostrar');
    });
    document.getElementById('menuNavegacao')?.addEventListener('click', (e) => e.stopPropagation());

    document.querySelectorAll('[data-secao]').forEach(item => {
        item.addEventListener('click', (e) => {
            e.preventDefault();
            document.querySelectorAll('.secao').forEach(s => s.classList.remove('ativa'));
            document.querySelectorAll('.aba, .item-menu').forEach(a => a.classList.remove('ativa'));
            const id = item.dataset.secao;
            document.getElementById(id)?.classList.add('ativa');
            document.querySelectorAll(`[data-secao="${id}"]`).forEach(el => el.classList.add('ativa'));
            document.getElementById('menuNavegacao').classList.remove('mostrar');
            
            if(id === 'global') setTimeout(carregarRankingGlobal, 300);
            else voltarParaResultados();
        });
    });

    document.getElementById('filtroMoeda')?.addEventListener('change', () => {
        const termo = document.getElementById('pesquisaGlobal')?.value.trim();
        termo ? buscarMoedasGlobal() : carregarRankingGlobal();
    });

    document.getElementById('formLaunchpad')?.addEventListener('submit', (e) => {
        e.preventDefault();
        document.getElementById('mensagemSucesso').style.display = 'block';
        e.target.reset();
        setTimeout(() => document.getElementById('mensagemSucesso').style.display = 'none', 5000);
    });
}

async function buscarTaxaBRL(){
    try{
        const res = await fetch(`${API_CG}/simple/price?ids=usd&vs_currencies=brl`, {cache:'force-cache'});
        const d = await res.json();
        taxaBRL = d.usd.brl || 5.40;
    }catch(e){ taxaBRL = 5.40; }
}

async function atualizarDados(){
    await buscarTaxaBRL();
    try{
        const res = await fetch(`${API_CG}/simple/price?ids=doge-manga,bitcoin,solana,ethereum&vs_currencies=usd,brl&include_24hr_change=true`, {cache:'no-store'});
        if(!res.ok) throw new Error('API fora do ar');
        const d = await res.json();
        const html = `
            <div class="item-moeda destaque"><img src="IMG-20260727-WA0036(7).jpg" style="width:18px; height:18px; border-radius:50%;"><strong>$DGM</strong>: $${d['doge-manga']?.usd?.toFixed(8) || '---'}</div>
            <div class="item-moeda">BTC: $${d.bitcoin?.usd?.toLocaleString('pt-BR',{maximumFractionDigits:0}) || '---'}</div>
            <div class="item-moeda">SOL: $${d.solana?.usd?.toFixed(2) || '---'}</div>
            <div class="item-moeda">ETH: $${d.ethereum?.usd?.toFixed(2) || '---'}</div>
        `;
        document.getElementById('barraPrecos').innerHTML = html;
    }catch(e){
        document.getElementById('barraPrecos').innerHTML = `<div class="aviso-api">⚠️ Dados indisponíveis no momento</div>`;
    }
}

async function buscarMoedasGlobal(){
    const termo = document.getElementById('pesquisaGlobal').value.trim();
    if(!termo) return carregarRankingGlobal();
    document.getElementById('areaResultadosGlobal').innerHTML = `<div class="carregando">🔍 Buscando...</div>`;
    try{
        const res = await fetch(`${API_CG}/search?query=${encodeURIComponent(termo)}`, {cache:'no-store'});
        if(res.status===429){ document.getElementById('areaResultadosGlobal').innerHTML = `<div class="aviso-api">⏳ Aguardando limite... tentando em 6,5s</div>`; setTimeout(buscarMoedasGlobal,6500); return; }
        if(!res.ok) throw new Error('Falha na busca');
        const d = await res.json();
        if(!d.coins?.length){ document.getElementById('areaResultadosGlobal').innerHTML = `<div class="erro-busca">❌ Nenhuma moeda encontrada</div>`; return; }
        exibirListaMoedas(d.coins.map(c => ({id:c.id,name:c.name,symbol:c.symbol,image:c.large,current_price:0,price_change_percentage_24h:0,market_cap:0,total_volume:0})));
    }catch(e){ document.getElementById('areaResultadosGlobal').innerHTML = `<div class="erro-busca">❌ ${e.message}</div>`; }
}

async function carregarRankingGlobal(){
    document.getElementById('areaResultadosGlobal').innerHTML = `<div class="carregando">📊 Carregando ranking...</div>`;
    try{
        const res = await fetch(`${API_CG}/coins/markets?vs_currency=usd&order=market_cap_desc&per_page=100&page=${paginaGlobal}&sparkline=false`, {cache:'no-store'});
        if(res.status===429){ document.getElementById('areaResultadosGlobal').innerHTML = `<div class="aviso-api">⏳ Aguardando limite... tentando em 6,5s</div>`; setTimeout(carregarRankingGlobal,6500); return; }
        if(!res.ok) throw new Error('Serviço indisponível');
        const d = await res.json();
        exibirListaMoedas(d);
    }catch(e){ document.getElementById('areaResultadosGlobal').innerHTML = `<div class="erro-busca">❌ ${e.message}</div>`; }
}

function exibirListaMoedas(lista){
    const moedaRef = document.getElementById('filtroMoeda').value;
    let html = `<table class="tabela-global"><thead><tr><th>#</th><th>Nome</th><th>Preço</th><th>24h %</th><th>Cap. Mercado</th><th>Volume 24h</th></tr></thead><tbody>`;
    lista.forEach((m,i) => {
        const preco = moedaRef==='brl' ? (m.current_price||0)*taxaBRL : (m.current_price||0);
        const var24 = m.price_change_percentage_24h||0;
        html += `<tr onclick="abrirDetalheMoeda('${m.id}')">
            <td>${(paginaGlobal-1)*100+i+1}</td>
            <td><img src="${m.image}" class="icone-moeda" alt="${m.name}">${m.name} <small>(${m.symbol.toUpperCase()})</small></td>
            <td>${moedaRef==='brl'?'R$':'$'} ${preco.toLocaleString('pt-BR',{maximumFractionDigits:8})}</td>
            <td class="${var24>=0?'var-positiva':'var-negativa'}">${var24>=0?'+':''}${var24.toFixed(2)}%</td>
            <td>$ ${(m.market_cap||0).toLocaleString('pt-BR')}</td>
            <td>$ ${(m.total_volume||0).toLocaleString('pt-BR')}</td>
        </tr>`;
    });
    html += `</tbody></table><div class="paginacao">
        <button onclick="paginaGlobal--; carregarRankingGlobal()" ${paginaGlobal===1?'disabled':''}>← Anterior</button>
        <span style="padding:8px 12px; color:var(--primaria); font-weight:600;">Página ${paginaGlobal}</span>
        <button onclick="paginaGlobal++; carregarRankingGlobal()">Próxima →</button>
    </div>`;
    document.getElementById('areaResultadosGlobal').innerHTML = html;
    voltarParaResultados();
}

async function abrirDetalheMoeda(id){
    document.getElementById('areaResultadosGlobal').style.display = 'none';
    document.getElementById('detalhesMoedaGlobal').classList.add('visivel');
    document.getElementById('nomeMoedaDetalhe').textContent = 'Carregando...';
    try{
        const res = await fetch(`${API_CG}/coins/${id}?localization=false&tickers=false&community_data=false&developer_data=false`, {cache:'no-store'});
        if(res.status===429){ setTimeout(()=>abrirDetalheMoeda(id),6500); return; }
        if(!res.ok) throw new Error('Dados não encontrados');
        const m = await res.json();
        const moedaRef = document.getElementById('filtroMoeda').value;
        const preco = moedaRef==='brl' ? m.market_data.current_price.brl : m.market_data.current_price.usd;
        document.getElementById('nomeMoedaDetalhe').innerHTML = `<img src="${m.image.large}" style="width:40px; height:40px; border-radius:50%; vertical-align:middle; margin-right:10px;">${m.name} (${m.symbol.toUpperCase()})`;
        document.getElementById('dadosMoedaDetalhe').innerHTML = `
            <div class="dado"><strong>${moedaRef==='brl'?'R$':'$'} ${preco.toLocaleString('pt-BR',{maximumFractionDigits:8})}</strong><span>Preço atual</span></div>
            <div class="dado" style="color:${m.market_data.price_change_percentage_24h>=0?'var(--sucesso)':'var(--erro)'}"><strong>${m.market_data.price_change_percentage_24h>=0?'+':''}${m.market_data.price_change_percentage_24h.toFixed(2)}%</strong><span>Variação 24h</span></div>
            <div class="dado"><strong>$ ${(m.market_data.market_cap.usd||0).toLocaleString('pt-BR')}</strong><span>Capitalização</span></div>
            <div class="dado"><strong>$ ${(m.market_data.total_volume.usd||0).toLocaleString('pt-BR')}</strong><span>Volume 24h</span></div>
            <div class="dado"><strong>$ ${(m.market_data.fully_diluted_valuation.usd||0).toLocaleString('pt-BR')}</strong><span>Valor Total (FDV)</span></div>
            <div class="dado"><strong>${(m.market_data.circulating_supply||0).toLocaleString('pt-BR')}</strong><span>Oferta circulante</span></div>
            <div class="dado"><strong>${(m.market_data.total_supply||0).toLocaleString('pt-BR')}</strong><span>Oferta total</span></div>
        `;
        document.getElementById('graficoMoedaDetalhe').innerHTML = `<iframe src="https://www.coingecko.com/pt-br/moedas/${id}/embed" style="width:100%; height:100%; border:none;" loading="lazy"></iframe>`;
        document.getElementById('botoesNegociacao').innerHTML = `
            <a href="https://dexscreener.com/search?q=${m.symbol}" target="_blank" rel="noopener" class="btn btn-secundario">🔍 Ver no DexScreener</a>
            <a href="https://www.coingecko.com/pt-br/moedas/${id}" target="_blank" rel="noopener" class="btn btn-secundario">📄 Página CoinGecko</a>
        `;
    }catch(e){ document.getElementById('nomeMoedaDetalhe').textContent = '❌ Erro ao carregar dados'; }
}

function voltarParaResultados(){
    const detalhes = document.getElementById('detalhesMoeda
